{
  "name": "itsh-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "IT-Shaharcha frontend — npm-workspaces monorepo (public, learner, console apps + shared packages)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:public": "npm run dev -w @itsh/public",
    "build:public": "npm run build -w @itsh/public",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
